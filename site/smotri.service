[Unit]
Description=Smotri website and gated downloads
After=network-online.target
[Service]
User=smotri
Group=smotri
WorkingDirectory=/opt/smotri/site
Environment=SMOTRI_CONFIG=/etc/smotri/config.json
ExecStart=/opt/smotri/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8317 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/smotri
[Install]
WantedBy=multi-user.target
