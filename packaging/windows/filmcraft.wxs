<?xml version="1.0" encoding="utf-8"?>
<!--
  Smotri MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build filmcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Smotri"
      Manufacturer="AKT.MP4"
      Version="$(var.Version)"
      UpgradeCode="93D35B50-4BC9-459D-AAB1-89ACDC2262E5"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Smotri video editor" Manufacturer="AKT.MP4" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Smotri is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FilmcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FilmcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://smotri.cc" />
    <Property Id="ARPURLUPDATEINFO" Value="https://smotri.cc" />
    <Property Id="ARPHELPLINK" Value="https://t.me/aktmp4" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Smotri" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Smotri" Level="1">
      <ComponentGroupRef Id="FilmcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="FilmcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="FilmcraftApp" Guid="15933017-925B-4963-8992-52000EB26AAA">
        <File Id="FilmcraftExe" Source="$(var.BinDir)\filmcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Smotri"
              Description="Smotri video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="FilmcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\filmcraft.exe" Value="[#FilmcraftExe]" Type="string" />
      </Component>

      <Component Id="FilmcraftCli">
        <File Id="FilmcraftCliExe" Source="$(var.BinDir)\filmcraft-cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="AudioPluginHost">
        <File Id="AudioPluginHostExe" Source="$(var.BinDir)\filmcraft-audio-plugin-host.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
